# Agent - 环境配置示例
# 复制此文件为 .env 并填入实际值

# ===== AI 模型配置 =====

# 默认 LLM 提供商 (openai / deepseek / azure / anthropic / ollama)
LLM_PROVIDER=deepseek

# API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Base URL（可选，默认使用官方 API）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== MCP 配置 =====

# 默认 MCP 服务器配置（JSON 格式）
# MCP_SERVERS={"mcpServers":{"filesystem":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem"]}}}

# ===== 数据库配置 =====

# 数据库类型: sqlite / postgres
DB_TYPE=sqlite
# SQLite 文件路径（DB_TYPE=sqlite 时有效）
DB_PATH=data/agent.db
# PostgreSQL（DB_TYPE=postgres 时有效）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agent
# DB_USER=agent
# DB_PASSWORD=your_db_password

# ===== 日志配置 =====

LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# ===== UI 配置 =====

# 主题: dark / light
UI_THEME=dark
# 默认模型
DEFAULT_MODEL=deepseek-v4-flash
# 上下文长度
DEFAULT_CONTEXT_LENGTH=50
# 温度 (0.0 - 2.0)
DEFAULT_TEMPERATURE=0.7

# ===== 插件配置 =====

# 插件目录
PLUGIN_DIR=plugins
# 启用插件热加载
PLUGIN_HOT_RELOAD=true

# ===== 技能配置 =====

# 技能目录
SKILL_DIR=skills
# MD 技能目录
SKILL_MD_DIR=skills/md

# ===== API 服务 =====

# HTTP API 端口
API_PORT=8000
# API 密钥（留空则不启用认证）
API_KEY=
# CORS 允许来源
CORS_ORIGINS=*

# ===== 开发配置 =====

# 调试模式
DEBUG=false
# 启用性能分析
ENABLE_PROFILER=false