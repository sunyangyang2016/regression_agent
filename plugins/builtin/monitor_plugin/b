"""监控插件桥接层 - JS <-> Python 通信（只读远程监控快照）"""
import json
import os
import time
from datetime import datetime
from PyQt5.QtCore import QObject, pyqtSlot
from ..controller import monitor_controller


# 项目根目录（跳过 5 级: bridge -> monitor_plugin -> builtin -> plugins -> 根）
_PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(
    os.path.dirname(os.path.abspath(__file__))
))))
# 远程监控数据快照文件（AI 通过 collect_stats.py 写入，插件只读）
SNAPSHOT_FILE = os.path.join(_PROJECT_ROOT, "storage", "remote_monitor_data.json")
# 提醒队列文件（AI 通过 push_alert.py 写入，插件只读）
ALERTS_FILE = os.path.join(_PROJECT_ROOT, "storage", "monitor_alerts.json")
# 快照有效期（秒）：超过 3 秒未更新视为过期/不可用
SNAPSHOT_TTL = 3.0


# ==========================================
# 提醒队列读取（只读，AI 写入）
# ==========================================

def read_alerts(max_items: int = 50) -> list:
    """读取提醒队列（最近 max_items 条）"""
    try:
        if os.path.exists(ALERTS_FILE):
            with open(ALERTS_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, list):
                    return data[-max_items:]
    except Exception as e:
        print(f"[MonitorBridge] ⚠️ 读取提醒队列失败: {e}")
    return []


# ==========================================
# 远程快照读取（只读，AI 写入）
# ==========================================

def read_remote_snapshot() -> dict:
    """
    读取远程监控数据快照，判断有效性。
    返回: 有效时返回快照 dict（含 data_source='remote'）
          无效（缺失/过期）时返回 {'data_source': 'unavailable'}
    """
    try:
        if not os.path.exists(SNAPSHOT_FILE):
            return {"data_source": "unavailable", "error": "远程监控数据快照不存在"}
        mtime = os.path.getmtime(SNAPSHOT_FILE)
        if time.time() - mtime > SNAPSHOT_TTL:
            return {"data_source": "unavailable", "error": "远程监控数据快照已过期"}
        with open(SNAPSHOT_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            return {"data_source": "unavailable", "error": "快照格式错误"}
        data["data_source"] = "remote"
        return data
    except Exception as e:
        print(f"[MonitorBridge] ⚠️ 读取远程快照失败: {e}")
        return {"data_source": "error", "error": str(e)}


class MonitorBridge(QObject):
    """供前端 monitor.js 调用的 QWebChannel 桥（只读远程快照展示）"""

    @pyqtSlot(result=str)
    def getStats(self):
        """获取远程设备汇总统计"""
        try:
            return json.dumps(read_remote_snapshot(), ensure_ascii=False)
        except Exception as e:
            print(f"[MonitorBridge] [ERROR] getStats: {e}")
            return '{"data_source":"error","error":"' + str(e) + '"}'

    @pyqtSlot(result=str)
    def getProcesses(self):
        """获取远程设备 Top N 进程详情"""
        try:
            data = read_remote_snapshot()
            return json.dumps(data.get("processes", []) if data.get("data_source") == "remote" else [], ensure_ascii=False)
        except Exception as e:
            print(f"[MonitorBridge] [ERROR] getProcesses: {e}")
            return "[]"

    @pyqtSlot(str, result=str)
    def getProcessesLimit(self, max_count):
        """获取指定数量的远程 Top N 进程详情"""
        try:
            count = int(max_count or 8)
            data = read_remote_snapshot()
            procs = data.get("processes", []) if data.get("data_source") == "remote" else []
            return json.dumps(procs[:count], ensure_ascii=False)
        except Exception as e:
            print(f"[MonitorBridge] [ERROR] getProcessesLimit: {e}")
            return "[]"

    @pyqtSlot(result=str)
    def getDisks(self):
        """获取远程设备磁盘分区使用情况"""
        try:
            data = read_remote_snapshot()
            return json.dumps(data.get("disks", []) if data.get("data_source") == "remote" else [], ensure_ascii=False)
        except Exception as e:
            print(f"[MonitorBridge] [ERROR] getDisks: {e}")
            return "[]"

    @pyqtSlot(result=str)
    def getAll(self):
        """一次性获取远程设备全部监控数据"""
        try:
            return json.dumps(read_remote_snapshot(), ensure_ascii=False)
        except Exception as e:
            print(f"[MonitorBridge] [ERROR] getAll: {e}")
            return '{"data_source":"error","error":"' + str(e) + '"}'

    @pyqtSlot(result=str)
    def getAlerts(self):
        """获取异常提醒队列（由 AI 通过 push_alert.py 写入）"""
        try:
            return json.dumps(read_alerts(50), ensure_ascii=False)
        except Exception as e:
            print(f"[MonitorBridge] [ERROR] getAlerts: {e}")
            return "[]"