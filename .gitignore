# Python
__pycache__/
*.py[cod]

# Virtual Environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs（logs 目录下所有文件均不纳入版本库，含会话 AI 通信日志 history/）
logs/

# MCP Server
tools/mcp/server/

# User config（用户个性化配置目录：仅提交 README.md，其余文件含 apiKey 的 models.json 不纳入版本库）
user_config/user/*
!user_config/user/README.md

# Database
user_config/database/*.db
user_config/database/*.db-shm
user_config/database/*.db-wal

# Runtime IPC artifacts（video_plugin 与 skill 脚本间的运行时产物，不入版本库）
storage/video_commands.json
storage/video_plugin.json

# RAG（向量库/文件记录/模型缓存不入版本库，user_config/rag/README.md 除外）
user_config/rag/*.db
user_config/rag/*.db-shm
user_config/rag/*.db-wal
user_config/rag/vector_db/
user_config/rag/models/